@page
@model RazorDemo.Pages.ContactModel
@{
    ViewData["Title"] = "Contact Us";
}

<div class="contact-wrapper">
    <div class="contact-container row mx-0">
        <!-- Left Side -->
        <div class="contact-info col-md-5">
            <h1 class="contact-title">Contact Us</h1>
            <p class="contact-desc">
                We are committed to processing the information in order to contact you and talk about your project.
            </p>

            <div class="contact-detail">
                <i class="bi bi-envelope icon-orange"></i>
                <span>example@teamwebflow.com</span>
            </div>
            
            <div class="contact-detail">
                <i class="bi bi-house icon-orange"></i>
                <span>4074 Ebert Summit Suite 375<br>Lake Leonardchester</span>
            </div>
            
            <div class="contact-detail">
                <i class="bi bi-copy icon-orange"></i>
                <span>+44 123 654 7890</span>
            </div>
        </div>

        <!-- Right Side: Form -->
        <div class="contact-form-wrapper col-md-7">
            <form class="contact-form">
                <div class="mb-4 input-wrap">
                    <input type="text" class="form-control custom-input" placeholder="Name*" required>
                </div>
                <div class="mb-4 input-wrap">
                    <input type="email" class="form-control custom-input" placeholder="Email*" required>
                </div>
                <div class="mb-4 input-wrap">
                    <input type="text" class="form-control custom-input" placeholder="Website*" required>
                </div>
                <div class="mb-4 input-wrap">
                    <textarea class="form-control custom-input" rows="4" placeholder="Message"></textarea>
                </div>
                <button type="submit" class="btn btn-gradient-submit w-100">Submit</button>
            </form>
        </div>
    </div>
</div>

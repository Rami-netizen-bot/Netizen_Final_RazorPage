@page
@model RazorDemo.Pages.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="main-wrapper pt-5">
    <div class="container">
        <!-- Header section with title and admin badge -->
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h1 class="hero-title mb-0">Admin <span class="text-blue">Dashboard</span></h1>
                <p class="hero-subtitle">Manage your users and monitor platform statistics.</p>
            </div>
            <div class="badge-pill">
                <i class="bi bi-shield-check me-2"></i> Admin Mode
            </div>
        </div>

        <!-- Stats Overview Cards: Displays summary counts from the Model -->
        <div class="row mb-5">
            <!-- Total Users Card -->
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="box-label mb-1">TOTAL USERS</p>
                            <h2 class="mb-0">@Model.TotalUsers</h2>
                        </div>
                        <div class="icon-box blue">
                            <i class="bi bi-people-fill"></i>
                        </div>
                    </div>
                    <div class="tag-label mt-3">Platform Reach</div>
                </div>
            </div>
            <!-- Administrators Count Card -->
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="box-label mb-1">ADMINISTRATORS</p>
                            <h2 class="mb-0">@Model.AdminCount</h2>
                        </div>
                        <div class="icon-box purple">
                            <i class="bi bi-person-badge-fill"></i>
                        </div>
                    </div>
                    <div class="tag-label mt-3">System Access</div>
                </div>
            </div>
            <!-- Students Count Card -->
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="box-label mb-1">STUDENTS</p>
                            <h2 class="mb-0">@Model.StudentCount</h2>
                        </div>
                        <div class="icon-box pink">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>
                    </div>
                    <div class="tag-label mt-3">Active Learning</div>
                </div>
            </div>
        </div>

        <!-- User Management Table Section -->
        <div class="learning-card-box">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="mb-0"><i class="bi bi-table me-2"></i> User Management</h5>
                <div class="search-box">
                    <input type="text" class="form-control form-control-sm bg-dark border-secondary text-white" placeholder="Search users...">
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table table-hover text-white align-middle" style="border-color: #1a2a4a;">
                    <thead>
                        <tr class="text-muted small">
                            <th>ID</th>
                            <th>NAME</th>
                            <th>EMAIL</th>
                            <th>GENDER</th>
                            <th>ROLE</th>
                            <th class="text-end">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td class="text-muted">#@user.Id</td>
                                <td>
                                    <!-- User identity with dynamic color based on role -->
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box small me-2 @(user.Role == "Admin" ? "purple" : "blue")" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                            @user.Name?.Substring(0, 1).ToUpper()
                                        </div>
                                        @user.Name
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    <!-- Gender Badge -->
                                    <span class="badge rounded-pill bg-dark border border-secondary px-3">@user.Gender</span>
                                </td>
                                <td>
                                    <!-- Logic to determine and display the correct Role Badge -->
                                    @{
                                        var displayRole = string.IsNullOrEmpty(user.Role) ? "Student" : user.Role;
                                    }
                                    @if (string.Equals(displayRole, "Admin", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge rounded-pill bg-danger text-white px-3">Admin</span>
                                    }
                                    else if (string.Equals(displayRole, "Student", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge rounded-pill bg-success text-white px-3">Student</span>
                                    }
                                    else if (string.Equals(displayRole, "User", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge rounded-pill bg-info text-dark px-3">User</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary text-white px-3">@displayRole</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <!-- Action Buttons: Delete (with confirmation) and Edit -->
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@user.Id" onsubmit="return confirm('Are you sure you want to delete this user?');" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger border-0">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                    <a asp-page="/EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-info border-0 ms-1">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Local styles for enhancing the dashboard table appearance -->
    <style>
        .table-hover tbody tr:hover {
            background-color: rgba(0, 210, 255, 0.05) !important;
            color: #00d2ff !important;
        }
        .table {
            background-color: transparent !important;
            color: white !important;
        }
        .table thead th {
            border-bottom: 2px solid #1a2a4a !important;
            color: #718096 !important;
            letter-spacing: 1px;
            font-weight: 700;
        }
        .table td {
            border-bottom: 1px solid #1a2a4a !important;
            padding: 1.2rem 0.75rem;
            background-color: transparent !important;
            color: white !important;
        }
        .btn-outline-danger:hover {
            background-color: #dc3545;
            color: white !important;
        }
        .btn-outline-info:hover {
            background-color: #0dcaf0;
            color: black !important;
        }
    </style>
}

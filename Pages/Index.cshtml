@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}
<link rel="stylesheet" href="~/css/home.css" />

<!-- Main wrapper for the entire home page content -->
<div class="main-wrapper">
    <!-- Hero Section: The primary visual area with the title and logo -->
    <section class="hero-section container">
        <div class="row align-items-center">
            
            <!-- Left Column: Contains text, title, and buttons -->
            <div class="col-lg-7">
                <!-- Decorative badge for the course project info -->
                <div class="badge-pill">Final Exam Project Razor Page .Net C#</div>
                
                <h1 class="hero-title">
                    Learn to build <br />
                    <span class="text-blue">real-world</span> websites <br />
                    with C# and Razor Pages
                </h1>
                
                <p class="hero-subtitle">
                    It is mini project for final exam of Web Programming course. This project is built using Razor Pages
                    in ASP.NET Core, showcasing a simple yet effective way to create dynamic web applications with C#.
                    The homepage features a hero section with a compelling title, a brief description, and
                    call-to-action buttons to encourage users to explore courses and projects.
                </p>
                
                <!-- Action buttons for navigation -->
                <div class="hero-btns">
                    <a href="#" class="btn-cyan">Browse Courses</a>
                    <a href="#" class="btn-outline">View Projects</a>
                </div>
            </div>

            <!-- Right Column: Contains the animated brand logo -->
            <div class="col-lg-5 text-center d-none d-lg-block">
                <div class="hero-logo-wrapper">
                    <!-- The logo image with a floating animation defined in site.css -->
                    <img src="~/images/logo.png" alt="Netizen Logo" class="img-fluid hero-logo" asp-append-version="true">
                </div>
            </div>
            
        </div>
    </section>
</div>

@page
@model HomeModel
@{
    ViewData["Title"] = "Home";
}
<!-- Font Awesome 6 for high-quality icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<div class="main-wrapper">
    <!-- Hero Section -->
    <section class="hero-section container">
        <div class="row align-items-center">
            <!-- Left Content -->
            <div class="col-lg-7">
                <div class="badge-pill">@Model.BadgeText</div>
                <h1 class="hero-title">
                    @Model.MainHeading <br />
                    <span class="text-blue">@Model.HightlightedText</span> websites <br />
                    with C# and Razor Pages
                </h1>
                <p class="hero-subtitle">
                    @Model.Subtitle
                </p>
                <div class="hero-btns">
                    <!-- GitHub Button -->
                    <a href="@Model.GitHubUrl" class="btn-cyan">
                        <i class="fa-brands fa-github"></i> GitHub
                    </a>

                    <!-- More Social Media Button -->
                    <a href="@Model.TelegramUrl" class="btn-outline">
                        <i class="fa-brands fa-telegram"></i> Telegram
                    </a>
                </div>
            </div>

            <!-- Right Content (Logo) -->
            <div class="col-lg-5 text-center d-none d-lg-block">
                <div class="hero-logo-wrapper">
                    <img src="~/images/logo.png" alt="Netizen Logo" class="img-fluid hero-logo"
                         asp-append-version="true">
                </div>
            </div>
        </div>
    </section>

    <!-- Project Technologies Section -->

</div>
@page
@model RazorDemo.Pages.ResumeModel
@{
    ViewData["Title"] = "Resume";
}
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="resume-wrapper">
    <div class="resume-document">
        <a href="javascript:window.print()" class="resume-download-btn d-print-none" title="Download CV">
            <i class="bi bi-download"></i>
        </a>
        <header class="resume-header">
            <h1 class="resume-name">@Model.Name</h1>
            <p class="resume-subtitle">@Model.Title</p>
            <p class="resume-contact">
                @Model.Email || @Model.PhoneNumber || @Model.Location
            </p>
        </header>

        <div class="resume-body row mt-5">
            <div class="col-md-5 resume-left">
                <div class="resume-section">
                    <h2 class="resume-section-title">Technical Skills</h2>
                    <div class="resume-skills">
                        @foreach (var skill in Model.TechnicalSkill)
                        {
                            <span class="skill-chip"> @skill </span>
                        }
                    </div>
                </div>
                <div class="resume-section mt-5">
                    <h2 class="resume-section-title">Soft Skills</h2>
                    <div class="resume-skills">
                        @foreach (var soft in Model.Softskill)
                        {
                            <span class="skill-chip">@soft</span>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-7 resume-right">
                <div class="resume-section">
                    <h2 class="resume-section-title">Summary</h2>
                    <p class="resume-text">
                        @Model.Summary
                    </p>
                </div>

                <div class="resume-section mt-5">
                    <h2 class="resume-section-title">More</h2>
                    <ul class="resume-list">
                        @foreach (var detail in Model.AdditinalDetails)
                        {
                            <li>@detail</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

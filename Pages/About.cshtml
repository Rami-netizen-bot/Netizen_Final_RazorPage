@page
@model RazorDemo.Pages.AboutModel
@{
    ViewData["Title"] = "About Us";
}

<div class="about-container">
    <div class="about-crosshairs"></div>
    <section class="about-header text-center mx-auto">
        <h1 class="about-title">About Us</h1>
        <p class="about-intro mx-auto">
            Lorem ipsum dolor sit amet consectetur adipisicing elit. Dolore ullam eos porro, obcaecati similique ducimus consequatur quas nostrum officiis repellendus! Doloribus voluptates blanditiis adipisci, consequuntur cumque doloremque nisi at officia.
        </p>
    </section>

    <div class="about-image-wrapper">
        <img src="~/images/about_us_team.png" alt="Our Team" class="featured-image img-fluid" />
    </div>

    <section class="about-footer text-center mx-auto">
        <p class="about-outro mx-auto">
            We collaborate closely with our clients, understanding their vision and business goals. Our mission is to help you stand out and create lasting impressions that drive growth. Let's build something unforgettable together!
        </p>
        <a href="/Contact" class="btn btn-get-in-touch mt-4">Get In Touch</a>
    </section>
</div>
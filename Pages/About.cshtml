@page
@model RazorDemo.Pages.AboutModel
@{
    ViewData["Title"] = "About";
}

<div class="about-container mt-2 mb-2">
    <section class="text-center mb-2">
        <h1>About Me</h1>
    </section>
    <div class="portfolio-container">
        <!-- Left Side: Profile Card -->
        <section class="profile-card">
            <img src="/images/photo_2025-10-31_11-27-40.jpg" alt="Ramy Man" class="profile-img">
            <h1>@Model.ProfileName</h1>
            <p class="subtitle">@Model.Subtitile</p>

            <div class="tags">
                @foreach (var tages in Model.MainTags)
                {
                    <span>@tages</span>
                }
            </div>

            <div class="links">
                <div class="link-item">@Model.Email</div>
                <div class="link-item">@Model.PhoneNumber</div>
                <div class="link-item">Facebook <a href="@Model.FacebookUrl"></a></div>
            </div>
        </section>

        <!-- Right Side: Details Card -->
        <section class="details-card">
            <h2>My Story</h2>
            <p>
                @Model.Mystory
            </p>

            <div class="focus-box">
                <h3>Current Focus</h3>
                <p>@Model.CurrentFocus</p>
            </div>

            <div class="skills-grid">
                @foreach (var skills in Model.Skillgroups)
                {
                    <div class="skill-tile">
                        <h4>@skills.Title</h4>
                        <p>@skills.Teachnologies</p>
                    </div>
                }

            </div>
        </section>
    </div>

    <!-- Optional: Footer section if still needed, but styled subtly -->
    <!-- <section class="about-footer text-center mx-auto mt-5">
        <a href="/Contact" class="btn btn-get-in-touch">Get In Touch</a>
    </section> -->
</div>
